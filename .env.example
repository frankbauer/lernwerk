# Kopieren nach .env (wird nicht eingecheckt). Die Datei wird vom Browser geladen und ist damit
# öffentlich lesbar – hier keine Geheimnisse ablegen.

# Abstand in Sekunden, in dem der Code auf den Übungsseiten automatisch gespeichert wird (0 = aus)
AUTOSAVE_INTERVAL=30

# Nur für "npm run deploy": Zielordner, in den die von git verwalteten Dateien kopiert werden
# DEPLOY_TARGET=/pfad/zum/webserver/livecompile/
